select dev_type
    , sum (case when end_session is null then 1.0 else 0.0 end) as summ
    , sum (case when end_session is null then 1.0 else 0.0 end)/count (*)*100 as share_device_type
    , sum (case when end_session is null then 1.0 else 0.0 end)/3262*100 as share_game_sessions
