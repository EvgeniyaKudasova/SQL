##Задание 2.

Рассчитайте K-factor нашей игры - 0.35.
Рассчитайте, сколько пользователей нам принесет одна будущая среднестатистическая когорта в результате - 315 

with cnt_ref as
    (select 
          count (r.id_user)::float/count (u.id_user) as avg_ref
        , sum (case when ref_reg = '1' then 1.0 else 0.0 end)*100/count (ref_reg) as share_reg_friend
        , (count (r.id_user)::float/count (u.id_user))*(sum (case when ref_reg = '1' then 1.0 else 0.0 end)/count(ref_reg)) as k_factor
    from skygame.users u
       full join skygame.referral r
            on u.id_user=r.id_user
    )
,
size_cohorts as
        (select 
              date_trunc ('month', reg_date) as mm
            , count (u.id_user) as id_user
        from skygame.users u
            full join skygame.referral r
                on u.id_user=r.id_user
        group by mm
        )
,
avg_cohorts as
    (select sum (id_user)/count (mm) as avg_cohorts
    from size_cohorts
    )

select 
   round (k_factor*avg_cohorts)
from cnt_ref, avg_cohorts
